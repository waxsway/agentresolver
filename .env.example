NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Paid capabilities are OFF unless explicitly enabled.
AGENT_READINESS_ENABLED=false

# x402 seller configuration. Do not populate until mainnet activation is approved.
AGENTRESOLVER_PAY_TO=
AGENTRESOLVER_NETWORK=eip155:8453
X402_FACILITATOR_URL=

# Optional Coinbase CDP facilitator. Disabled by default.
# Enabling can create facilitator usage subject to Coinbase's current pricing.
AGENTRESOLVER_CDP_FACILITATOR_ENABLED=0
# Keep initial CDP exposure bounded to the cheapest Bazaar canary.
AGENTRESOLVER_CDP_FACILITATOR_CAPABILITIES=x402-ping
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional additive Circle Gateway Nanopayments rail for EVM buyers.
# Disabled by default. Set to 1 only after compatibility/revenue-flow approval.
AGENTRESOLVER_CIRCLE_GATEWAY_ENABLED=0

# Optional human-sales checkout. Leave blank until xPay merchant onboarding is
# complete and a live $500 AgentResolver Sprint payment link exists.
XPAY_SPRINT_DEPOSIT_URL=
