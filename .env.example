NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Paid capabilities are OFF unless explicitly enabled.
AGENT_READINESS_ENABLED=false

# x402 seller configuration. Do not populate until mainnet activation is approved.
AGENTRESOLVER_PAY_TO=
AGENTRESOLVER_NETWORK=eip155:8453
X402_FACILITATOR_URL=

# Optional Coinbase CDP Facilitator rail for Bazaar-indexable settlement.
# Disabled by default. Enabling can eventually incur facilitator fees after the monthly free tier.
AGENTRESOLVER_CDP_FACILITATOR_ENABLED=0
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional additive Circle Gateway Nanopayments rail for EVM buyers.
# Disabled by default. Set to 1 only after compatibility/revenue-flow approval.
AGENTRESOLVER_CIRCLE_GATEWAY_ENABLED=0
