{
  "schemaVersion": "1.0",
  "service": "AgentResolver",
  "canonical": "https://agentresolver.vercel.app",
  "protocol": "x402",
  "protocolVersion": 2,
  "resources": [
    {
      "id": "batch-verified-resolve",
      "name": "Batch Verified Resolve",
      "description": "Resolve and live-verify up to four capability requests, probing up to two MCP candidates per request.",
      "method": "POST",
      "url": "https://agentresolver.vercel.app/api/batch-verified-resolve",
      "contentType": "application/json",
      "input": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "minItems": 1, "maxItems": 4}}},
      "price": {"amountUsd": 1, "asset": "USDC", "network": "eip155:8453", "scheme": "exact"},
      "payment": {"challengeStatus": 402, "challengeHeader": "PAYMENT-REQUIRED", "authorizationHeader": "PAYMENT-SIGNATURE", "settlementHeader": "PAYMENT-RESPONSE"},
      "spendingPolicy": "Calling agents must independently authorize payment. Discovery never authorizes spending."
    },
    {
      "id": "verified-resolve",
      "name": "Verified Resolve",
      "description": "Resolve a missing capability and live-verify up to two top MCP candidates before returning a recommendation.",
      "method": "POST",
      "url": "https://agentresolver.vercel.app/api/verified-resolve",
      "contentType": "application/json",
      "input": {"type": "object", "required": ["goal"], "properties": {"goal": {"type": "string"}, "url": {"type": "string"}}},
      "price": {"amountUsd": 0.25, "asset": "USDC", "network": "eip155:8453", "scheme": "exact"},
      "payment": {"challengeStatus": 402, "challengeHeader": "PAYMENT-REQUIRED", "authorizationHeader": "PAYMENT-SIGNATURE", "settlementHeader": "PAYMENT-RESPONSE"},
      "spendingPolicy": "Calling agents must independently authorize payment. Discovery never authorizes spending."
    },
    {
      "id": "mcp-probe",
      "name": "MCP Probe",
      "description": "Probe a public MCP HTTP endpoint for protocol compatibility, latency, server metadata, and tool inventory.",
      "method": "POST",
      "url": "https://agentresolver.vercel.app/api/mcp-probe",
      "contentType": "application/json",
      "input": {"type": "object", "required": ["endpoint"], "properties": {"endpoint": {"type": "string"}}},
      "price": {"amountUsd": 0.01, "asset": "USDC", "network": "eip155:8453", "scheme": "exact"},
      "payment": {"challengeStatus": 402, "challengeHeader": "PAYMENT-REQUIRED", "authorizationHeader": "PAYMENT-SIGNATURE", "settlementHeader": "PAYMENT-RESPONSE"},
      "spendingPolicy": "Calling agents must independently authorize payment. Discovery never authorizes spending."
    },
    {
      "id": "agent-readiness",
      "name": "Agent Readiness Audit",
      "description": "Audit a public website for AI-agent discoverability, llms.txt, ARD, OpenAPI, sitemap, MCP metadata, and baseline headers.",
      "method": "POST",
      "url": "https://agentresolver.vercel.app/api/agent-readiness",
      "contentType": "application/json",
      "input": {"type": "object", "required": ["target"], "properties": {"target": {"type": "string"}}},
      "price": {"amountUsd": 0.05, "asset": "USDC", "network": "eip155:8453", "scheme": "exact"},
      "payment": {"challengeStatus": 402, "challengeHeader": "PAYMENT-REQUIRED", "authorizationHeader": "PAYMENT-SIGNATURE", "settlementHeader": "PAYMENT-RESPONSE"},
      "spendingPolicy": "Calling agents must independently authorize payment. Discovery never authorizes spending."
    }
  ],
  "discovery": {
    "openapi": "https://agentresolver.vercel.app/openapi.json",
    "capabilities": "https://agentresolver.vercel.app/capabilities.json",
    "llms": "https://agentresolver.vercel.app/llms.txt",
    "resolver": "https://agentresolver.vercel.app/api/resolve"
  }
}
