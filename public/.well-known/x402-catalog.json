{
  "schemaVersion": "1.1",
  "service": "AgentResolver",
  "canonical": "https://agentresolver.vercel.app",
  "protocol": "x402",
  "protocolVersion": 2,
  "positioning": "Free capability discovery; tiny pay-per-call live evidence when an agent needs confidence before depending on an external service.",
  "resources": [
    {
      "id": "http-inspect",
      "name": "x402 API Trust Preflight",
      "description": "Verify a live x402 payment contract before an agent spends: quoted price, payee, network, asset, resource binding, challenge structure, TLS and reachability. Accepts USDC on Base or Solana.",
      "method": "POST",
      "url": "https://agentresolver.vercel.app/api/http-inspect",
      "contentType": "application/json",
      "input": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "example": {
        "url": "https://example.com"
      },
      "price": {
        "amountUsd": 0.001,
        "asset": "USDC",
        "network": "eip155:8453",
        "scheme": "exact",
        "networks": [
          "eip155:8453",
          "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp"
        ],
        "paymentOptions": [
          {
            "network": "eip155:8453",
            "payTo": "0x66E19457fFC829E8Ed74706f5c1399C6F6466dE8"
          },
          {
            "network": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
            "payTo": "AoQNzm7dB7dhBXfgq9ywqkfkS68fg2e1JwcxrgXnkLXa"
          }
        ]
      },
      "payment": {
        "challengeStatus": 402,
        "challengeHeader": "PAYMENT-REQUIRED",
        "authorizationHeader": "PAYMENT-SIGNATURE",
        "settlementHeader": "PAYMENT-RESPONSE"
      },
      "spendingPolicy": "Calling agents must independently authorize payment. Discovery never authorizes spending."
    },
    {
      "id": "mcp-probe",
      "name": "MCP Live Preflight",
      "description": "Given one public MCP HTTP endpoint, return current reachability, MCP protocol compatibility, latency, server metadata, and tool inventory. Designed as the cheapest pre-dependency check before an agent connects to an unfamiliar MCP server.",
      "method": "POST",
      "url": "https://agentresolver.vercel.app/api/mcp-probe",
      "contentType": "application/json",
      "input": {
        "type": "object",
        "required": [
          "endpoint"
        ],
        "properties": {
          "endpoint": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "example": {
        "endpoint": "https://example.com/mcp"
      },
      "price": {
        "amountUsd": 0.001,
        "asset": "USDC",
        "network": "eip155:8453",
        "scheme": "exact",
        "networks": [
          "eip155:8453",
          "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp"
        ],
        "paymentOptions": [
          {
            "network": "eip155:8453",
            "payTo": "0x66E19457fFC829E8Ed74706f5c1399C6F6466dE8"
          },
          {
            "network": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
            "payTo": "AoQNzm7dB7dhBXfgq9ywqkfkS68fg2e1JwcxrgXnkLXa"
          }
        ]
      },
      "payment": {
        "challengeStatus": 402,
        "challengeHeader": "PAYMENT-REQUIRED",
        "authorizationHeader": "PAYMENT-SIGNATURE",
        "settlementHeader": "PAYMENT-RESPONSE"
      },
      "spendingPolicy": "Calling agents must independently authorize payment. Discovery never authorizes spending."
    },
    {
      "id": "agent-readiness",
      "name": "Agent Readiness Audit",
      "description": "Audit a public website for AI-agent discoverability and machine-readable integration signals including llms.txt, ARD, OpenAPI, sitemap, MCP metadata, robots, and baseline headers.",
      "method": "POST",
      "url": "https://agentresolver.vercel.app/api/agent-readiness",
      "contentType": "application/json",
      "input": {
        "type": "object",
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "example": {
        "target": "https://example.com"
      },
      "price": {
        "amountUsd": 0.005,
        "asset": "USDC",
        "network": "eip155:8453",
        "scheme": "exact",
        "networks": [
          "eip155:8453",
          "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp"
        ],
        "paymentOptions": [
          {
            "network": "eip155:8453",
            "payTo": "0x66E19457fFC829E8Ed74706f5c1399C6F6466dE8"
