        "challengeStatus": 402,
        "challengeHeader": "PAYMENT-REQUIRED",
        "authorizationHeader": "PAYMENT-SIGNATURE",
        "settlementHeader": "PAYMENT-RESPONSE"
      },
      "spendingPolicy": "Calling agents must independently authorize payment. Discovery never authorizes spending."
    },
    {
      "id": "batch-verified-resolve",
      "name": "Batch Verified Resolve",
      "description": "Resolve and live-verify up to four missing capability requests in one call, returning evidence-backed selections while bounding live MCP probe work.",
      "method": "POST",
      "url": "https://agentresolver.vercel.app/api/batch-verified-resolve",
      "contentType": "application/json",
      "input": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "goal"
              ],
              "properties": {
                "goal": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      },
      "example": {
        "items": [
          {
            "goal": "Find an MCP server for search"
          },
          {
            "goal": "Find an MCP server for browser automation"
          }
        ]
      },
      "price": {
        "amountUsd": 0.05,
        "asset": "USDC",
        "network": "eip155:8453",
        "scheme": "exact",
        "networks": [
