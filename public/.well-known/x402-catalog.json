        "challengeStatus": 402,
        "challengeHeader": "PAYMENT-REQUIRED",
        "authorizationHeader": "PAYMENT-SIGNATURE",
        "settlementHeader": "PAYMENT-RESPONSE"
      },
      "spendingPolicy": "Calling agents must independently authorize payment. Discovery never authorizes spending."
    },
    {
      "id": "verified-resolve",
      "name": "Verified Resolve",
      "description": "Resolve one missing capability, live-verify up to two top MCP candidates, and return an evidence-backed recommendation instead of directory metadata alone.",
      "method": "POST",
      "url": "https://agentresolver.vercel.app/api/verified-resolve",
      "contentType": "application/json",
      "input": {
        "type": "object",
        "required": [
          "goal"
        ],
        "properties": {
          "goal": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "example": {
        "goal": "Find and verify an MCP server for web search"
      },
      "price": {
        "amountUsd": 0.02,
        "asset": "USDC",
        "network": "eip155:8453",
        "scheme": "exact",
        "networks": [
          "eip155:8453",
          "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp"
        ],
        "paymentOptions": [
          {
            "network": "eip155:8453",
