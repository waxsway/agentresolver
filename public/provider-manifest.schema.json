{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentresolver.vercel.app/provider-manifest.schema.json",
  "title": "AgentResolver Provider Manifest",
  "description": "Machine-native zero-account provider enrollment manifest. Publishing this file at /.well-known/agentresolver-provider.json on the same HTTPS origin as the listed routes opts the provider into the published AgentResolver provider commerce contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "commercial", "routes"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://agentresolver.vercel.app/provider-manifest.schema.json"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "commercial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["successFeeBps", "minimumSuccessFeeUsd"],
      "properties": {
        "successFeeBps": {
          "type": "integer",
          "const": 200
        },
        "minimumSuccessFeeUsd": {
          "type": "number",
          "const": 0.001
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "routeId",
          "capabilityId",
          "name",
          "description",
          "endpoint",
          "method",
          "priceUsd",
          "payment"
        ],
        "properties": {
          "routeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "capabilityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "tags": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "method": {
            "type": "string",
            "enum": ["GET", "POST"]
          },
          "priceUsd": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "payment": {
            "type": "object",
            "additionalProperties": false,
            "required": ["network", "asset", "payTo", "amountAtomic"],
            "properties": {
              "network": {
                "type": "string",
                "const": "eip155:8453"
              },
              "asset": {
                "type": "string",
                "const": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
              },
              "payTo": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "amountAtomic": {
                "type": "string",
                "pattern": "^[0-9]{1,78}$"
              }
            }
          }
        }
      }
    }
  },
  "x-agentresolver-semanticConstraints": [
    "The manifest must be served from https://PROVIDER_ORIGIN/.well-known/agentresolver-provider.json.",
    "Every route endpoint must have the same URL origin as the manifest.",
    "Every routeId must begin with provider.id followed by a colon.",
    "priceUsd must equal payment.amountAtomic divided by 1000000 within AgentResolver's bounded rounding tolerance.",
    "Enrollment is accepted only after the live unsigned x402 v2 challenge matches method, endpoint resource binding, network, asset, payTo, and amountAtomic.",
    "Private, local, reserved, credential-bearing, custom-port, malformed, and oversized targets fail closed."
  ]
}
