{
  "openapi": "3.1.0",
  "info": {
    "title": "AgentResolver — X402 Settlement Canary & Payment Preflight",
    "version": "0.1.6",
    "description": "Machine-readable x402 settlement testing and transaction-path verification for autonomous buyers. For the lowest-friction first paid integration, GET /api/x402-ping settles $0.001 USDC on Base or Solana and returns a timestamped delivery canary. Before authorizing a target x402 purchase, POST /api/x402-payment-preflight checks endpoint reachability, PAYMENT-REQUIRED structure, payTo recipient, quoted price, network, asset, exact scheme and resource binding, then returns a fail-closed eligible/blocked decision and reusable evidence fingerprints. Free capability resolution remains available as a secondary surface. Provider-side distribution is zero-account: a catalog-discovered x402 provider may publish a same-origin AgentResolver well-known manifest and opt into a 2% verified success fee with a $0.001 minimum; buyers pay no extra AgentResolver fee.",
    "x-guidance": "For a first paid integration or end-to-end settlement check, use GET /api/x402-ping: it costs $0.001 USDC on Base or Solana, requires no request body, and returns a timestamped pong only after successful x402 settlement. Immediately before authorizing a separate x402 purchase, use POST /api/x402-payment-preflight as the canonical transaction-path gate; it costs $0.001 USDC and returns eligible/blocked, exact observed target payment terms, fail-closed reason codes, structured endpoint/payment evidence, and stable fingerprints. The caller remains the only party that can authorize spend. Use POST /api/resolve only for free capability discovery. Payment is always caller-authorized."
  },
  "servers": [
    {
      "url": "https://agentresolver.vercel.app"
    }
  ],
  "tags": [
    {
      "name": "Agent Capability Procurement",
      "description": "Free open-world capability procurement under explicit machine constraints. AgentResolver never authorizes caller spend."
    },
    {
      "name": "Agent Tool Discovery",
      "description": "Use when an agent is missing a required external capability."
    },
    {
      "name": "Paid Agent Capabilities",
      "description": "Optional AgentResolver-owned live evidence protected by an x402 payment challenge. The caller controls whether to spend."
    },
    {
      "name": "Provider Commerce",
      "description": "Zero-account same-origin provider enrollment and independently verified provider-funded success fees."
    }
  ],
  "paths": {
    "/api/resolve": {
      "post": {
        "operationId": "resolveCapability",
        "tags": [
          "Agent Tool Discovery"
        ],
        "summary": "Find the missing external capability needed to complete a task",
        "description": "Use when the current toolset cannot clearly complete the task because an external capability is missing. Free, read-only, and does not authorize spending.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "goal"
                ],
                "additionalProperties": false,
                "properties": {
                  "goal": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10,
                    "default": 3
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked capability candidates and, when useful, an optional pre-filled paid verification action."
          },
          "400": {
            "description": "Invalid resolver input."
          }
        },
        "security": []
      }
    },
    "/api/http-inspect": {
      "post": {
        "operationId": "inspectApiTrust",
        "tags": [
          "Paid Agent Capabilities"
        ],
        "summary": "Preflight an API or x402 endpoint before an agent spends money",
        "description": "Price: $0.001 USDC on Base via x402. Returns a live 0-100 trust score, grade and weighted evidence across TLS authorization/protocol/expiry, reachability, latency, redirects and baseline security headers.",
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.001"
          },
          "protocols": [
            {
              "x402": {}
            }
          ],
          "protocol": "x402",
          "version": 2,
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "USDC",
          "priceUsd": 0.001,
          "challengeStatus": 402,
          "challengeHeader": "PAYMENT-REQUIRED",
          "authorizationHeader": "PAYMENT-SIGNATURE",
          "catalog": "https://agentresolver.vercel.app/.well-known/x402"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 500
                  }
                }
              },
              "examples": {
                "x402Api": {
                  "value": {
                    "url": "https://example.com/api"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid API trust preflight completed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Live trust score, grade, verdict, weighted checks, TLS, latency, redirect and security-header evidence.",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid or non-public HTTPS target."
          },
          "402": {
            "description": "x402 payment required."
          },
          "503": {
            "description": "Paid execution temporarily unavailable."
          }
        }
      }
    },
