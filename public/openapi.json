    "/api/health": {
      "get": {
        "operationId": "getAgentResolverHealth",
        "tags": [
          "Agent Tool Discovery"
        ],
        "summary": "Check AgentResolver availability without running discovery",
        "responses": {
          "200": {
            "description": "AgentResolver is available."
          }
        },
        "security": []
      }
    },
    "/api/procure": {
      "post": {
        "operationId": "procureCapability",
        "tags": [
          "Agent Capability Procurement"
        ],
        "summary": "Procure a compatible machine capability under hard constraints",
        "description": "Free, read-only and non-custodial. Declare the capability needed plus budget/network/protocol/schema/side-effect/auth constraints. AgentResolver rejects incompatible candidates, surfaces unknown evidence explicitly, and returns a direct execution/payment handoff. It never receives a private key or authorizes caller spend.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "goal"
                ],
                "additionalProperties": false,
                "properties": {
                  "goal": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20,
                    "default": 5
                  },
                  "constraints": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "maxPriceUsd": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000
                      },
                      "preferredNetworks": {
                        "type": "array",
                        "maxItems": 8,
                        "items": {
                          "type": "string"
                        }
                      },
                      "protocol": {
                        "type": "string",
                        "enum": [
                          "x402",
                          "mcp",
                          "any"
                        ]
                      },
                      "requireHttps": {
                        "type": "boolean",
                        "default": true
                      },
                      "availableInputSchema": {
                        "type": "object"
                      },
                      "requiredOutputSchema": {
                        "type": "object"
                      },
                      "sideEffect": {
                        "type": "string",
                        "enum": [
                          "read-only",
                          "state-changing",
                          "any"
                        ]
                      },
                      "auth": {
                        "type": "string",
                        "enum": [
                          "none",
                          "wallet",
                          "api-key",
                          "any"
                        ]
                      }
                    }
                  }
                }
              },
              "examples": {
                "x402Search": {
                  "value": {
                    "goal": "search the public web and return structured results",
                    "constraints": {
                      "maxPriceUsd": 0.05,
                      "protocol": "x402",
                      "preferredNetworks": [
                        "eip155:8453"
                      ],
                      "requireHttps": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked compatible candidates, explicit rejection/unknown reasons, and a non-custodial execution/payment handoff."
          },
          "400": {
            "description": "Invalid procurement request or constraint schema."
          }
        },
        "security": []
      }
    }
  }
