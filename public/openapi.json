    "/api/providers": {
      "get": {
        "operationId": "getProviderNetwork",
        "tags": [
          "Provider Commerce"
        ],
        "summary": "Read the provider-network and self-enrollment contract",
        "description": "Free machine-readable provider contract. Domain providers can self-enroll without an account or operator review by publishing /.well-known/agentresolver-provider.json on the same HTTPS origin as a catalog-discovered x402 route. Before attributed procurement, AgentResolver performs a bounded unsigned probe and requires the live x402 v2 402 challenge to match the manifest scheme, Base network, canonical Base USDC asset, payTo, amount and resource binding; mismatches fail closed.",
        "security": [],
        "responses": {
          "200": {
            "description": "Provider enrollment, attribution, fee, safety and verification contract."
          }
        }
      }
    },
    "/api/provider-attribution-verify": {
      "post": {
        "operationId": "verifyProviderConversion",
        "tags": [
          "Provider Commerce"
        ],
        "summary": "Verify a routed buyer settlement before a provider success fee is due",
        "description": "Free verification. Re-resolves a static provider route or same-origin provider manifest and independently verifies the submitted Base-USDC buyer settlement against the provider's published payment identity. When AgentResolver's dedicated attribution signer is active, a matching signed handoff receipt is also required and cryptographically binds the attribution ID to the exact provider route/payment terms.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "attributionId",
                  "providerId",
                  "routeId",
                  "buyerTxHash"
                ],
                "additionalProperties": false,
                "properties": {
                  "attributionId": {
                    "type": "string",
                    "pattern": "^atr_[0-9a-fA-F-]{36}$"
                  },
                  "providerId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "routeId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "providerOrigin": {
                    "type": "string",
                    "pattern": "^https://[^/]+/?$",
                    "description": "Required for zero-state domain-manifest providers; omit for statically registered legacy partners."
                  },
                  "buyerTxHash": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{64}$"
                  },
                  "attributionReceipt": {
                    "type": "string",
                    "maxLength": 16384,
                    "description": "AgentResolver-issued signed attribution receipt from the procurement/provider handoff. Required for provider fee eligibility whenever the dedicated attribution signing secret is active."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Buyer settlement verified and provider success-fee quote returned."
          },
          "400": {
            "description": "Invalid or unknown provider proof."
          },
          "422": {
            "description": "Buyer settlement did not satisfy the provider payment identity."
          }
        }
      }
    },
    "/api/provider-success-fee-quote": {
      "post": {
        "operationId": "quoteProviderSuccessFee",
        "tags": [
          "Provider Commerce"
        ],
        "summary": "Quote AgentResolver's provider-funded fee for verified routed commerce",
        "description": "Free quote after independently verifying the buyer-to-provider Base-USDC settlement. Domain-enrolled providers owe 2% of verified routed GMV with a $0.001 minimum. The exact atomic amount includes a tiny deterministic attribution-bound suffix so same-sized fee proofs cannot be trivially replayed across attributions.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "attributionId",
                  "providerId",
                  "routeId",
                  "buyerTxHash"
                ],
                "additionalProperties": false,
                "properties": {
                  "attributionId": {
                    "type": "string",
