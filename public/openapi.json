{
  "openapi": "3.1.0",
  "info": {
    "title": "AgentResolver — Find Missing Agent Tools",
    "version": "0.1.4",
    "description": "Free read-only fallback discovery for autonomous agents, plus low-cost x402 live verification. Resolution never authorizes spending; paid execution requires the calling agent to satisfy the advertised x402 payment challenge under its own spending policy.",
    "x-guidance": "Use POST /api/resolve first for free capability discovery. Use paid routes only when exact live evidence or deterministic computation is worth the listed per-call price. Payment is always caller-authorized."
  },
  "servers": [
    {
      "url": "https://agentresolver.vercel.app"
    }
  ],
  "tags": [
    {
      "name": "Agent Tool Discovery",
      "description": "Use when an agent is missing a required external capability."
    },
    {
      "name": "Paid Agent Capabilities",
      "description": "Optional AgentResolver-owned live evidence protected by an x402 payment challenge. The caller controls whether to spend."
    }
  ],
  "paths": {
    "/api/resolve": {
      "post": {
        "operationId": "resolveCapability",
        "tags": [
          "Agent Tool Discovery"
        ],
        "summary": "Find the missing external capability needed to complete a task",
        "description": "Use when the current toolset cannot clearly complete the task because an external capability is missing. Free, read-only, and does not authorize spending.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "goal"
                ],
                "additionalProperties": false,
                "properties": {
                  "goal": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10,
                    "default": 3
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked capability candidates and, when useful, an optional pre-filled paid verification action."
          },
          "400": {
            "description": "Invalid resolver input."
          }
        },
        "security": []
      }
    },
    "/api/http-inspect": {
      "post": {
        "operationId": "inspectApiTrust",
        "tags": [
          "Paid Agent Capabilities"
        ],
        "summary": "Preflight an API or x402 endpoint before an agent spends money",
        "description": "Price: $0.001 USDC on Base via x402. Returns a live 0-100 trust score, grade and weighted evidence across TLS authorization/protocol/expiry, reachability, latency, redirects and baseline security headers.",
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.001"
          },
          "protocols": [
            {
              "x402": {}
            }
          ],
          "protocol": "x402",
          "version": 2,
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "USDC",
          "priceUsd": 0.001,
          "challengeStatus": 402,
          "challengeHeader": "PAYMENT-REQUIRED",
          "authorizationHeader": "PAYMENT-SIGNATURE",
          "catalog": "https://agentresolver.vercel.app/.well-known/x402"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 500
                  }
                }
              },
              "examples": {
                "x402Api": {
                  "value": {
                    "url": "https://example.com/api"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid API trust preflight completed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Live trust score, grade, verdict, weighted checks, TLS, latency, redirect and security-header evidence.",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid or non-public HTTPS target."
          },
          "402": {
            "description": "x402 payment required."
          },
          "503": {
            "description": "Paid execution temporarily unavailable."
          }
        }
      }
    },
    "/api/mcp-probe": {
      "post": {
        "operationId": "probeMcpEndpoint",
        "tags": [
          "Paid Agent Capabilities"
        ],
        "summary": "Live-preflight a public MCP HTTP endpoint before depending on it",
        "description": "Price: $0.001 USDC on Base via x402. Checks initialize and tools/list and returns reachability, compatibility, latency, server metadata, and current tool inventory.",
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.001"
          },
          "protocols": [
            {
              "x402": {}
            }
          ],
          "protocol": "x402",
          "version": 2,
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "USDC",
          "priceUsd": 0.001,
          "challengeStatus": 402,
          "challengeHeader": "PAYMENT-REQUIRED",
          "authorizationHeader": "PAYMENT-SIGNATURE",
          "catalog": "https://agentresolver.vercel.app/.well-known/x402"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "endpoint"
                ],
                "additionalProperties": false,
                "properties": {
                  "endpoint": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 500
                  }
                }
              },
              "examples": {
                "preflight": {
                  "value": {
                    "endpoint": "https://example.com/mcp"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid MCP live preflight completed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Structured JSON result from Live-preflight a public MCP HTTP endpoint before depending on it.",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid endpoint."
          },
          "402": {
            "description": "x402 payment required."
          },
          "503": {
            "description": "Paid execution temporarily unavailable."
          }
        }
      }
    },
    "/api/agent-readiness": {
      "post": {
        "operationId": "auditAgentReadiness",
        "tags": [
          "Paid Agent Capabilities"
        ],
        "summary": "Audit a public website for AI-agent discoverability",
        "description": "Price: $0.005 USDC on Base via x402. Audits a public site for agent discoverability and machine-readable integration signals.",
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.005"
          },
          "protocols": [
            {
              "x402": {}
            }
          ],
          "protocol": "x402",
          "version": 2,
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "USDC",
          "priceUsd": 0.005,
          "challengeStatus": 402,
          "challengeHeader": "PAYMENT-REQUIRED",
          "authorizationHeader": "PAYMENT-SIGNATURE",
          "catalog": "https://agentresolver.vercel.app/.well-known/x402"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "target"
                ],
                "additionalProperties": false,
                "properties": {
                  "target": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid audit completed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Structured JSON result from Audit a public website for AI-agent discoverability.",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid target."
          },
          "402": {
            "description": "x402 payment required."
          },
          "503": {
            "description": "Paid execution temporarily unavailable."
          }
        }
      }
    },
    "/api/verified-resolve": {
      "post": {
        "operationId": "verifiedResolve",
        "tags": [
          "Paid Agent Capabilities"
        ],
        "summary": "Resolve a missing capability and live-verify top MCP candidates",
        "description": "Price: $0.02 USDC on Base via x402. Resolves one capability, live-probes at most two top MCP candidates, and returns an evidence-backed recommendation.",
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.02"
          },
          "protocols": [
            {
              "x402": {}
            }
          ],
          "protocol": "x402",
          "version": 2,
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "USDC",
          "priceUsd": 0.02,
          "challengeStatus": 402,
          "challengeHeader": "PAYMENT-REQUIRED",
          "authorizationHeader": "PAYMENT-SIGNATURE",
          "catalog": "https://agentresolver.vercel.app/.well-known/x402"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "goal"
                ],
                "additionalProperties": false,
                "properties": {
                  "goal": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 500
                  }
                }
              },
              "examples": {
                "searchTool": {
                  "value": {
                    "goal": "Find and verify an MCP server for web search"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid verification completed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Structured JSON result from Resolve a missing capability and live-verify top MCP candidates.",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid input."
          },
          "402": {
            "description": "x402 payment required."
          },
          "503": {
            "description": "Paid execution temporarily unavailable."
          }
        }
      }
    },
    "/api/batch-verified-resolve": {
      "post": {
        "operationId": "batchVerifiedResolve",
        "tags": [
          "Paid Agent Capabilities"
        ],
        "summary": "Resolve and live-verify several missing capabilities in one paid operation",
        "description": "Price: $0.05 USDC on Base via x402. Accepts 1-4 capability requests. Each request may live-probe at most two MCP candidates, for a hard maximum of eight live MCP probes per paid batch.",
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.05"
          },
          "protocols": [
            {
              "x402": {}
            }
          ],
          "protocol": "x402",
          "version": 2,
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "USDC",
          "priceUsd": 0.05,
          "challengeStatus": 402,
          "challengeHeader": "PAYMENT-REQUIRED",
          "authorizationHeader": "PAYMENT-SIGNATURE",
          "catalog": "https://agentresolver.vercel.app/.well-known/x402"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "items"
                ],
                "additionalProperties": false,
                "properties": {
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "required": [
                        "goal"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "goal": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 600
                        },
                        "url": {
                          "type": "string",
                          "format": "uri",
                          "maxLength": 500
                        }
                      }
                    }
                  }
                }
              },
              "examples": {
                "procurementBatch": {
                  "value": {
                    "items": [
                      {
                        "goal": "Find and verify an MCP server for web search"
                      },
                      {
                        "goal": "Find and verify an MCP server for GitHub repositories"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid batch verification completed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Structured JSON result from Resolve and live-verify several missing capabilities in one paid operation.",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid batch input."
          },
          "402": {
            "description": "x402 payment required."
          },
          "503": {
            "description": "Paid execution temporarily unavailable."
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getAgentResolverHealth",
        "tags": [
          "Agent Tool Discovery"
        ],
        "summary": "Check AgentResolver availability without running discovery",
        "responses": {
          "200": {
            "description": "AgentResolver is available."
          }
        },
        "security": []
      }
    }
  }
}
