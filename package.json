  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "agent-tools",
    "tool-discovery",
    "api-discovery",
    "capability-discovery",
    "machine-services",
    "x402"
  ],
  "mcpName": "io.github.waxsway/agentresolver",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
