    "@x402/mcp": "2.25.0",
    "@x402/next": "2.25.0",
    "@x402/svm": "2.25.0",
    "next": "16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "viem": "2.56.5",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
